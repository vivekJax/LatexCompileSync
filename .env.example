# =============================================================================
# LatexCompileSync — copy to your LaTeX project root as .env
# =============================================================================

# ----- Build (optional) -----
# Main .tex file to compile (default: main.tex)
# MAIN_TEX=main.tex

# If set, copy compiled PDF to this filename (e.g. for a fixed deliverable name)
# OUTPUT_PDF=

# LaTeX engine: xelatex, pdflatex, lualatex (default: xelatex)
# TEX_ENGINE=xelatex

# ----- Overleaf sync (required for sync_to_overleaf.sh) -----
# Project ID from your Overleaf project URL: https://www.overleaf.com/project/<THIS_ID>
OVERLEAF_PROJECT_ID=

# Git token from Overleaf: Account Settings → Git integration → Generate token
# Prefer setup.sh --token-file so the token is not pasted into chat or shell history.
# https://www.overleaf.com/user/settings
OVERLEAF_TOKEN=

# Optional: path used by setup.sh when --token / --token-file are omitted
# OVERLEAF_TOKEN_FILE=$HOME/Tokens_API_Kumar/Overleaf.txt

# ----- Branch names -----
# setup.sh sets these after fetching Overleaf (usually both master).
# OVERLEAF_BRANCH_LOCAL=master
# OVERLEAF_BRANCH_REMOTE=master
